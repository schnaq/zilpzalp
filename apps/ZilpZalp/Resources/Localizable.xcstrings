      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erkenne den Vogel"
          }
        }
      }
    },
    "home.packsHint" : {
      "comment" : "One-time line for grown-ups on the home screen after the first profile: where more birds come from",
