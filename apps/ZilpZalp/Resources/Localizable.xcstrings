        }
      }
    },
    "credits.icons.title" : {
      "comment" : "Heading of the credits section that names the bundled icon sets",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Symbole"
          }
        }
      }
    },
    "credits.intro" : {
      "comment" : "The paragraph at the top of the credits screen. Says why the names are there and what happens on a tap",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Bilder und Aufnahmen stehen unter einer freien Lizenz. Die Quelle öffnet erst nach einer kurzen Aufgabe für Erwachsene."
          }
        }
      }
    },
    "credits.photo.by" : {
      "comment" : "Under a bird's name in the credits, for a photo. %1$@ is the photographer, %2$@ the licence's short name such as CC BY 4.0",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foto von %1$@ · %2$@"
          }
        }
      }
    },
    "credits.title" : {
      "comment" : "Row on the screen about the app that opens the credits, and the title of that screen",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotos & Dank"
          }
        }
      }
    },
    "credits.unavailable" : {
      "comment" : "Shown instead of the credits when the generated list is not in the bundle — a broken build rather than a state a parent can act on",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Liste konnte nicht geladen werden."
          }
        }
      }
    },
    "credits.vendored.by" : {
      "comment" : "Under a font family or an icon set in the credits. %1$@ are its authors, %2$@ the SPDX identifier of its licence such as OFL-1.1",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %2$@"
          }
        }
      }
    },
    "gate.hint.wrong" : {
      "comment" : "Shown under the parental gate's task after a wrong answer. Never a reprimand and never a lockout — the numbers have already changed",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das war nicht die richtige Zahl. Hier ist eine neue Aufgabe."
          }
        }
      }
    },
    "gate.question" : {
      "comment" : "The adult-level task of the parental gate. %1$@ and %2$@ are the two operands, spelled out in words so that solving it needs reading",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie viel ist %1$@ plus %2$@?"
          }
        }
      }
    },
    "gate.spoken" : {
      "comment" : "Spoken aloud when the parental gate appears, for the child who cannot read the task. The hint, never the question: reading the sum out would hand over the one thing the spelled-out numbers withhold",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frag bitte einen Erwachsenen."
          }
        }
      }
    },
    "home.collection.all" : {
      "comment" : "The collection that holds every bird on the device, first entry of the picker on the home screen",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Vögel"
          }
        }
      }
    },
    "home.collection.change.accessibility" : {
      "comment" : "VoiceOver label of the button on the home screen that opens the collection picker. %@ is the collection a child plays with right now",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vögel auswählen, jetzt: %@"
          }
        }
      }
    },
    "home.collection.done" : {
      "comment" : "Closes the collection picker and goes back to the games. The choice is already made, so this confirms nothing",
