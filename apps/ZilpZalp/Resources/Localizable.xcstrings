      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mehr Vögel, für Erwachsene"
          }
        }
      }
    },
    "home.collection.title" : {
      "comment" : "Asked — spoken and shown — over the collection picker: which birds the next round should be about",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Welche Vögel?"
          }
        }
      }
    },
    "home.game.calls.title" : {
      "comment" : "The name of game 2: a bird call plays, the child taps the bird. On the tile on the home screen and in the top bar of the round it opens",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wer singt da?"
          }
        }
      }
    },
    "home.game.names.title" : {
      "comment" : "The name of game 1: the bird's name is read out, the child taps the bird. On the tile on the home screen and in the top bar of the round it opens",
