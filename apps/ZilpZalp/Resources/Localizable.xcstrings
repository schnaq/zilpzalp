      }
    },
    "app.pack.failed" : {
      "comment" : "Shown instead of the home screen when the bundled species pack cannot be opened. Read by a grown-up, so a full sentence",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Vögel konnten nicht geladen werden."
          }
        }
      }
    },
    "collection.album.title" : {
      "comment" : "Title of the album screen. %@ is the child's name, already in the genitive („Johannas“, „Hans’“) — the app forms it, so a language that shows possession another way can restructure the whole line",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Sammlung"
          }
        }
      }
    },
    "collection.birds" : {
      "comment" : "Badge in the album. %lld is how many species have been collected",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "1 Vogel"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld Vögel"
                }
              }
            }
          }
        }
      }
    },
    "collection.locked" : {
      "comment" : "Caption under a sticker of a species not yet found. The sticker keeps its photo; only the name is still a secret",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch geheim"
          }
        }
      }
    },
    "collection.stars" : {
      "comment" : "Badge for a star count, in the album, on the ladder and in the swarm. %lld is the stars",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "1 Stern"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld Sterne"
                }
              }
            }
          }
        }
      }
    },
    "collection.title" : {
      "comment" : "Label on the home screen's pill that opens the album. The same word the round end's pill carries, see roundEnd.collection. The album screen itself is titled with the child's name, see collection.album.title",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sammlung"
          }
        }
      }
    },
    "credits.call.by" : {
      "comment" : "Under a bird's name in the credits, for a recording. %1$@ is the recordist, %2$@ the licence's short name such as CC BY 4.0",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aufnahme von %1$@ · %2$@"
          }
        }
      }
    },
    "credits.fonts.title" : {
      "comment" : "Heading of the credits section that names the bundled font families",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schriften"
          }
        }
      }
    },
    "credits.hint" : {
      "comment" : "Under the credits row",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Woher die Bilder kommen und wem sie gehören"
