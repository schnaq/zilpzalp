{
  "sourceLanguage" : "de",
  "strings" : {
    "about.intro" : {
      "comment" : "The paragraph at the top of the screen about the app: who makes it — the two authors, not the company (#224)",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Spiel von Johanna Hillebrand und Christian Meter."
          }
        }
      }
    },
    "about.mail.hint" : {
      "comment" : "Under the support row. The address itself, so a grown-up can write it down instead of tapping the row",
