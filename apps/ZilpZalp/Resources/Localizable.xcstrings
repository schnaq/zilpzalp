      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unser Schwarm"
          }
        }
      }
    },
    "link.gate.reason" : {
      "comment" : "Why the parental gate is being shown: a link is about to leave the app",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Link führt aus ZilpZalp hinaus."
          }
        }
      }
    },
    "link.mail.accessibility" : {
      "comment" : "VoiceOver hint on the row that opens an e-mail outside the app",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffnet eine E-Mail. Davor kommt eine Aufgabe für Erwachsene."
          }
        }
      }
    },
    "link.web.accessibility" : {
      "comment" : "VoiceOver hint on a row that opens a web page outside the app",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffnet eine Internetseite. Davor kommt eine Aufgabe für Erwachsene."
          }
        }
      }
    },
    "nav.back.accessibility" : {
      "comment" : "VoiceOver label of the back chevron in the top bar. The button itself is wordless",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zurück"
          }
        }
      }
    },
    "parents.gate.reason" : {
      "comment" : "Why the parental gate is being shown: the device has neither a code nor biometrics on file and cannot be asked",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Bereich ist für Erwachsene. Bitte lösen Sie kurz die Aufgabe."
          }
        }
      }
    },
    "parents.intro" : {
      "comment" : "The paragraph at the top of the unlocked grown-ups' area",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ZilpZalp lernt Vögel über Bilder und Rufe — ohne Lesen, ohne Punktejagd. Hier stellen Sie ein, was dabei zu hören und zu sehen ist."
          }
        }
      }
    },
    "parents.lock.explanation" : {
      "comment" : "The sentence on the locked grown-ups' area, above the unlock button",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hier stellen Erwachsene ein, wie ZilpZalp spielt. Das Gerät fragt einmal kurz nach."
          }
        }
      }
    },
    "parents.lock.reason" : {
      "comment" : "Subtitle of the system's own authentication sheet. LAContext demands a non-empty reason",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Elternbereich ist nur für Erwachsene."
          }
        }
      }
    },
    "parents.lock.refused" : {
      "comment" : "Shown after an attempt that did not go through — a wrong face, a wrong code, or a cancelled sheet. Calm, and it names the way on",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das hat nicht geklappt. Tippen Sie noch einmal auf „Entsperren“."
          }
        }
      }
    },
    "parents.lock.unlock" : {
      "comment" : "The button that asks the device to unlock the grown-ups' area",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entsperren"
          }
        }
      }
    },
    "parents.newBirds.accessibility" : {
      "comment" : "VoiceOver label of the grown-ups' door while it wears the new-birds sparkle",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einstellungen, neue Vögel"
          }
        }
      }
    },
    "parents.notice" : {
      "comment" : "Heading of the card in the grown-ups' area that states what the app does not do",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine Werbung, keine Käufe"
          }
        }
      }
    },
    "parents.notice.hint" : {
      "comment" : "The second line of the same card",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine Konten, keine Datenerhebung, kein Tracking."
          }
        }
      }
    },
    "parents.packs.action.load" : {
      "comment" : "The button on a pack's card that downloads it",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laden"
          }
        }
      }
    },
    "parents.packs.action.loaded" : {
      "comment" : "On the card of a pack that is on the device and up to date",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geladen"
          }
        }
      }
    },
    "parents.packs.action.play" : {
      "comment" : "On the card of a pack loaded just now: makes it the playing child's collection and goes home",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fertig – jetzt spielen"
          }
        }
      }
    },
    "parents.packs.action.resume" : {
      "comment" : "The button on a pack whose download stopped; it resumes",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weiterladen"
          }
        }
      }
    },
    "parents.packs.action.update" : {
      "comment" : "On the card of an installed pack the bucket holds a newer version of",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktualisieren"
          }
        }
      }
    },
    "parents.packs.alwaysThere" : {
      "comment" : "Second half of the base pack's row: it ships with the app and cannot be deleted",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "immer dabei"
          }
        }
      }
    },
    "parents.packs.complete" : {
      "comment" : "The bucket offers nothing that is not already on the device",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Pakete sind schon auf dem Gerät."
          }
        }
      }
    },
    "parents.packs.costly.cancel" : {
      "comment" : "The way out of the costly-connection question",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Später im WLAN"
          }
        }
      }
    },
    "parents.packs.costly.confirm" : {
      "comment" : "Downloads over the costly connection anyway",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trotzdem laden"
          }
        }
      }
    },
    "parents.packs.costly.message" : {
      "comment" : "Message of that question. %1$@ is the quoted pack title, or several joined with und, %2$@ their size together like 17 MB",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: %2$@. Das Gerät ist gerade nicht im WLAN oder spart Daten."
          }
        }
      }
