{
  "sourceLanguage" : "de",
  "strings" : {
    "app.pack.failed" : {
      "comment" : "Shown instead of the home screen when the bundled species pack cannot be opened. Read by a grown-up, so a full sentence",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Vögel konnten nicht geladen werden."
          }
        }
      }
    },
    "collection.birds" : {
      "comment" : "Badge in the album. %lld is how many species have been collected",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "1 Vogel"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld Vögel"
                }
              }
            }
          }
        }
      }
    },
    "collection.locked" : {
      "comment" : "Caption under a sticker of a species not yet found. The sticker keeps its photo; only the name is still a secret",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch geheim"
          }
        }
      }
    },
    "collection.stars" : {
      "comment" : "Badge for a star count, in the album, on the ladder and in the swarm. %lld is the stars",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "1 Stern"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld Sterne"
                }
              }
            }
          }
        }
      }
    },
    "collection.title" : {
      "comment" : "Title of the sticker album, and the label of the button that opens it",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meine Sammlung"
          }
        }
      }
    },
    "credits.call.by" : {
      "comment" : "Under a bird's name in the credits, for a recording. %1$@ is the recordist, %2$@ the licence's short name such as CC BY",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aufnahme von %1$@ · %2$@"
          }
        }
      }
    },
    "credits.fonts.title" : {
      "comment" : "Heading of the credits section that names the bundled font families",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schriften"
          }
        }
      }
    },
    "credits.gate.reason" : {
      "comment" : "Why the parental gate is being shown on the credits screen: a link is about to leave the app",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Link führt aus ZilpZalp hinaus ins Internet."
          }
        }
      }
    },
    "credits.icons.title" : {
      "comment" : "Heading of the credits section that names the bundled icon sets",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Symbole"
          }
        }
      }
    },
    "credits.intro" : {
      "comment" : "The paragraph at the top of the credits screen. Says why the names are there and what happens on a tap",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Bilder und Aufnahmen stehen unter einer freien Lizenz. Die Quelle öffnet erst nach einer kurzen Aufgabe für Erwachsene."
          }
        }
      }
    },
    "credits.link.accessibility" : {
      "comment" : "VoiceOver hint on every row of the credits that leads out of the app",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffnet eine Internetseite. Davor kommt eine Aufgabe für Erwachsene."
          }
        }
      }
    },
    "credits.photo.by" : {
      "comment" : "Under a bird's name in the credits, for a photo. %1$@ is the photographer, %2$@ the licence's short name such as CC BY",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foto von %1$@ · %2$@"
          }
        }
      }
    },
    "credits.unavailable" : {
      "comment" : "Shown instead of the credits when the generated list is not in the bundle — a broken build rather than a state a parent can act on",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Liste konnte nicht geladen werden."
          }
        }
      }
    },
    "credits.vendored.by" : {
      "comment" : "Under a font family or an icon set in the credits. %1$@ are its authors, %2$@ the SPDX identifier of its licence such as OFL-1.1",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %2$@"
          }
        }
      }
    },
    "gate.hint.wrong" : {
      "comment" : "Shown under the parental gate's task after a wrong answer. Never a reprimand and never a lockout — the numbers have already changed",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das war nicht die richtige Zahl. Hier ist eine neue Aufgabe."
          }
        }
      }
    },
    "gate.question" : {
      "comment" : "The adult-level task of the parental gate. %1$@ and %2$@ are the two operands, spelled out in words so that solving it needs reading",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie viel ist %1$@ plus %2$@?"
          }
        }
      }
    },
    "gate.spoken" : {
      "comment" : "Spoken aloud when the parental gate appears, for the child who cannot read the task. The hint, never the question: reading the sum out would hand over the one thing the spelled-out numbers withhold",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frag bitte einen Erwachsenen."
          }
        }
      }
    },
    "home.game.calls.title" : {
      "comment" : "Tile on the home screen for game 2: a bird call plays, the child taps the bird",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wer singt da?"
          }
        }
      }
    },
    "home.game.names.title" : {
      "comment" : "Tile on the home screen for game 1: the bird's name is read out, the child taps the bird",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wer ist das?"
          }
        }
      }
    },
    "home.title" : {
      "comment" : "Headline of the home screen, above the game tiles",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was möchtest du machen?"
          }
        }
      }
    },
    "leaderboard.motto" : {
      "comment" : "Line under 'Unser Schwarm'. It is what keeps the list from being a ranking",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder Stern zählt für den ganzen Schwarm."
          }
        }
      }
    },
    "leaderboard.title" : {
      "comment" : "Heading of the list of everybody who plays on this device",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unser Schwarm"
          }
        }
      }
    },
    "nav.back.accessibility" : {
      "comment" : "VoiceOver label of the back chevron in the top bar. The button itself is wordless",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zurück"
          }
        }
      }
    },
    "parents.calls.hint" : {
      "comment" : "Under the bird-call switch. Says what it does not cover: game 1 reads the question out and stays audible, or the game has no task left",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur die Aufnahmen. Spiel 1 wird weiter vorgelesen."
          }
        }
      }
    },
    "parents.calls.title" : {
      "comment" : "Switch in the grown-ups' area: whether the recorded bird calls play",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vogelstimmen"
          }
        }
      }
    },
    "parents.credits.hint" : {
      "comment" : "Under the credits row",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Woher die Bilder kommen und wem sie gehören"
          }
        }
      }
    },
    "parents.credits.title" : {
      "comment" : "Row in the grown-ups' area that opens the credits, and the title of that screen",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotos & Dank"
          }
        }
      }
    },
    "parents.gate.reason" : {
      "comment" : "Why the parental gate is being shown: the device has neither a code nor biometrics on file and cannot be asked",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Bereich ist für Erwachsene. Bitte lösen Sie kurz die Aufgabe."
          }
        }
      }
    },
    "parents.intro" : {
      "comment" : "The paragraph at the top of the unlocked grown-ups' area",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ZilpZalp lernt Vögel über Bilder und Rufe — ohne Lesen, ohne Punktejagd. Hier stellen Sie ein, was dabei zu hören und zu sehen ist."
          }
        }
      }
    },
    "parents.lock.explanation" : {
      "comment" : "The sentence on the locked grown-ups' area, above the unlock button",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hier stellen Erwachsene ein, wie ZilpZalp spielt. Das Gerät fragt einmal kurz nach."
          }
        }
      }
    },
    "parents.lock.reason" : {
      "comment" : "Subtitle of the system's own authentication sheet. LAContext demands a non-empty reason",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Elternbereich ist nur für Erwachsene."
          }
        }
      }
    },
    "parents.lock.refused" : {
      "comment" : "Shown after an attempt that did not go through — a wrong face, a wrong code, or a cancelled sheet. Calm, and it names the way on",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das hat nicht geklappt. Tippen Sie noch einmal auf „Entsperren“."
          }
        }
      }
    },
    "parents.lock.unlock" : {
      "comment" : "The button that asks the device to unlock the grown-ups' area",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entsperren"
          }
        }
      }
    },
    "parents.names.hint" : {
      "comment" : "Under the name switch",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vogelnamen unter den Bildern einblenden"
          }
        }
      }
    },
    "parents.names.title" : {
      "comment" : "Switch in the grown-ups' area: whether the bird's name is printed under its picture",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Namen anzeigen"
          }
        }
      }
    },
    "parents.notice" : {
      "comment" : "Heading of the card in the grown-ups' area that states what the app does not do",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine Werbung, keine Käufe"
          }
        }
      }
    },
    "parents.notice.hint" : {
      "comment" : "The second line of the same card",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine Konten, keine Datenerhebung, kein Tracking."
          }
        }
      }
    },
    "parents.playtime.cancel" : {
      "comment" : "Leaves the daily time budget dialog without changing the limit",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abbrechen"
          }
        }
      }
    },
    "parents.playtime.hint" : {
      "comment" : "Hint under the daily time budget row, and the message of its preset dialog",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die laufende Runde wird immer zu Ende gespielt"
          }
        }
      }
    },
    "parents.playtime.minutes" : {
      "comment" : "One daily time budget preset, in the row and in its dialog. %lld is the minutes",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld Min"
          }
        }
      }
    },
    "parents.playtime.none" : {
      "comment" : "The time budget's current value when there is no daily limit",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein Limit"
          }
        }
      }
    },
    "parents.playtime.title" : {
      "comment" : "Row in the grown-ups' area for the daily time budget",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spielzeit pro Tag"
          }
        }
      }
    },
    "parents.title" : {
      "comment" : "The grown-ups' area: the VoiceOver label of its door in the top bar, and the title of the area itself",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für Erwachsene"
          }
        }
      }
    },
    "profile.avatar.bird" : {
      "comment" : "VoiceOver name of the bird avatar in the creation grid. A child picks it by sight",
