    "profile.create.avatar.title" : {
      "comment" : "Subheading over the avatar grid on the profile creation screen",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Such dir einen Vogel aus"
          }
        }
      }
    },
    "profile.create.confirm" : {
      "comment" : "Button that saves the new profile and starts playing. One word, spoken by a child",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los!"
          }
        }
      }
    },
    "profile.create.name.placeholder" : {
      "comment" : "Placeholder in the empty name field, and its VoiceOver label. A grown-up or an older sibling types here",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Name"
          }
        }
      }
    },
    "profile.create.title" : {
      "comment" : "Headline of the profile creation screen, read aloud on arrival",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie heißt du?"
          }
        }
      }
    },
    "profile.picker.new" : {
      "comment" : "Card on the profile picker that opens the creation screen. A new nest, not a new profile",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neues Nest"
          }
        }
      }
    },
    "profile.picker.title" : {
      "comment" : "Headline of the profile picker, read aloud on arrival",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wer spielt heute?"
          }
        }
      }
    },
    "profile.store.failed" : {
      "comment" : "Shown instead of any profile screen when profiles.json cannot be read or written. Covers both, so it names neither: a failed save must not say 'could not be loaded'. Read by a grown-up",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit den Profilen stimmt etwas nicht."
          }
        }
      }
    },
    "profile.switch.accessibility" : {
      "comment" : "VoiceOver label of the avatar button in the home screen's top bar. It reopens the profile picker",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profil wechseln"
          }
        }
      }
    },
    "quiz.feedback.correct" : {
      "comment" : "Banner under the answers when the child taps the right bird",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genau!"
          }
        }
      }
    },
    "quiz.feedback.retry" : {
      "comment" : "Banner under the answers after a wrong tap. Never a failure: the child may keep tapping, and nothing is blocked",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fast! Hör nochmal hin."
          }
        }
      }
    },
    "quiz.photo.credit" : {
      "comment" : "Credit inside a bird photo. %1$@ is the photographer, %2$@ the licence's short name. Mandatory for CC BY and CC BY-SA",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foto: %1$@ (%2$@)"
          }
        }
      }
    },
    "quiz.progress.label" : {
      "comment" : "VoiceOver name of the leaf row in the top bar. Names the row; where the round stands is quiz.progress.value",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fortschritt"
          }
        }
      }
    },
    "quiz.progress.value" : {
      "comment" : "VoiceOver value of the leaf row. %1$lld is the question being asked, %2$lld the questions in the round. The row itself shows no digits",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld von %2$lld"
          }
        }
      }
    },
    "quiz.prompt.whereIs" : {
      "comment" : "The question in game 1, spoken by the app and shown above the answers. %1$@ is the German article, %2$@ the bird's name",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wo ist %1$@ %2$@?"
          }
        }
      }
    },
    "quiz.sound.accessibility" : {
      "comment" : "VoiceOver label of the round button that reads the question out again. The button itself is wordless",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frage noch einmal hören"
          }
        }
      }
    },
    "quiz.tile.accessibility" : {
      "comment" : "VoiceOver label of one answer tile. %lld is its position in the grid. Never the bird's name — that would read the answer out",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vogelfoto %lld"
          }
        }
      }
    },
    "quiz.unavailable" : {
      "comment" : "Shown instead of a round when the pack holds fewer than four species. Read by a grown-up, so a full sentence",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In diesem Paket sind zu wenige Vögel für ein Spiel."
          }
        }
      }
    },
    "roundEnd.collection" : {
      "comment" : "Button on the round end screen that opens the sticker album. Inert until the collection exists",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sammlung"
          }
        }
      }
    },
    "roundEnd.playAgain" : {
      "comment" : "Button on the round end screen that starts a new round",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nochmal spielen"
          }
        }
      }
    },
    "roundEnd.stars" : {
      "comment" : "Line under the headline of the round end screen. %lld is the stars the round earned, one to three",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Du hast einen Stern gesammelt"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Du hast %lld Sterne gesammelt"
                }
              }
            }
          }
        }
      }
    },
    "roundEnd.title" : {
      "comment" : "Headline of the round end screen, also spoken out loud",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Super gemacht!"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
