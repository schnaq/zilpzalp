      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Vögel konnten nicht geladen werden."
          }
        }
      }
    },
    "home.game.calls.title" : {
      "comment" : "Tile on the home screen for game 2: a bird call plays, the child taps the bird",
