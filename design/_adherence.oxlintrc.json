{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/core/**",
              "components/navigation/**",
              "components/quiz/**",
              "ui_kits/ipad_app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Baloo 2|Nunito))/i]",
        "message": "Font not provided by the design system. Available: Baloo 2, Nunito."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|icon|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, tone, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:leaf|hoopoe|sun|clay|rare|sand)$/]",
        "message": "<Badge> tone must be one of 'leaf' | 'hoopoe' | 'sun' | 'clay' | 'rare' | 'sand'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|size|icon|iconRight|block|disabled|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, tone, size, icon, iconRight, block, disabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:primary|accent|reward|quiet)$/]",
        "message": "<Button> tone must be one of 'primary' | 'accent' | 'reward' | 'quiet'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|lg|xl)$/]",
        "message": "<Button> size must be one of 'md' | 'lg' | 'xl'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|pad|elevation|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: children, tone, pad, elevation."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:paper|leaf|clay|sun|sand)$/]",
        "message": "<Card> tone must be one of 'paper' | 'leaf' | 'clay' | 'sun' | 'sand'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='elevation'] > Literal[value!=/^(?:none|sm|md|lg)$/]",
        "message": "<Card> elevation must be one of 'none' | 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChoiceTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:photo|name|credit|tone|state|size|dimmed|onSelect|key|ref|className|style|children)$/]",
        "message": "<ChoiceTile> doesn't accept that prop. Declared props: photo, name, credit, tone, state, size, dimmed, onSelect."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChoiceTile'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:papier|wald|wiese|rufe|belohnung|federn|rinde|beeren|sumpf)$/]",
        "message": "<ChoiceTile> tone must be one of 'papier' | 'wald' | 'wiese' | 'rufe' | 'belohnung' | 'federn' | 'rinde' | 'beeren' | 'sumpf'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChoiceTile'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:idle|chosen|correct|retry)$/]",
        "message": "<ChoiceTile> state must be one of 'idle' | 'chosen' | 'correct' | 'retry'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FeedbackBanner'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|icon|key|ref|className|style|children)$/]",
        "message": "<FeedbackBanner> doesn't accept that prop. Declared props: children, tone, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='FeedbackBanner'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:correct|retry|hint)$/]",
        "message": "<FeedbackBanner> tone must be one of 'correct' | 'retry' | 'hint'."
      },
      {
        "selector": "JSXOpeningElement[name.name='HomeTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|tone|stars|locked|size|onOpen|key|ref|className|style|children)$/]",
        "message": "<HomeTile> doesn't accept that prop. Declared props: icon, label, tone, stars, locked, size, onOpen."
      },
      {
        "selector": "JSXOpeningElement[name.name='HomeTile'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:leaf|clay|sun|hoopoe)$/]",
        "message": "<HomeTile> tone must be one of 'leaf' | 'clay' | 'sun' | 'hoopoe'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|color|strokeWidth|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, color, strokeWidth."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|tone|size|disabled|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: icon, label, tone, size, disabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:primary|accent|clay|quiet)$/]",
        "message": "<IconButton> tone must be one of 'primary' | 'accent' | 'clay' | 'quiet'."
      },
      {
        "selector": "JSXOpeningElement[name.name='QuizProgress'] > JSXAttribute > JSXIdentifier[name!=/^(?:total|done|current|size|key|ref|className|style|children)$/]",
        "message": "<QuizProgress> doesn't accept that prop. Declared props: total, done, current, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='RewardSticker'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|photo|credit|label|tone|locked|size|key|ref|className|style|children)$/]",
        "message": "<RewardSticker> doesn't accept that prop. Declared props: icon, photo, credit, label, tone, locked, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='RewardSticker'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:sun|leaf|hoopoe|rare)$/]",
        "message": "<RewardSticker> tone must be one of 'sun' | 'leaf' | 'hoopoe' | 'rare'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SettingRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|hint|value|on|onToggle|key|ref|className|style|children)$/]",
        "message": "<SettingRow> doesn't accept that prop. Declared props: icon, label, hint, value, on, onToggle."
      },
      {
        "selector": "JSXOpeningElement[name.name='SoundButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:playing|size|label|key|ref|className|style|children)$/]",
        "message": "<SoundButton> doesn't accept that prop. Declared props: playing, size, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='TopBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:onBack|onSettings|center|title|key|ref|className|style|children)$/]",
        "message": "<TopBar> doesn't accept that prop. Declared props: onBack, onSettings, center, title."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|tone|key|ref|className|style|children)$/]",
        "message": "<Wordmark> doesn't accept that prop. Declared props: size, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:duo|mono-light|mono-dark)$/]",
        "message": "<Wordmark> tone must be one of 'duo' | 'mono-light' | 'mono-dark'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
